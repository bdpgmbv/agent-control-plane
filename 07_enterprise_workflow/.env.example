# ============================================================
#  COPY TO ".env" AND PASTE YOUR KEY
#      cp .env.example .env
# ============================================================

# ---- 1. The model -----------------------------------------
# Only three steps in this workflow use a model. Everything else -
# the engine, the retries, the approvals, the compensation - is
# ordinary code, and runs identically with no key at all.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0


# ---- 2. WHERE THE TRUTH LIVES -----------------------------
# The database is the workflow. The running process is just something
# that advances it, and can be killed at any moment.
SQLITE_PATH=./data/workflows.db


# ---- 3. LEASES --------------------------------------------
# A worker claims a step for this many seconds. If the worker dies, the
# lease expires and another worker may pick the step up. Too short and a
# slow-but-healthy step gets stolen and run twice; too long and a crash
# stalls the workflow until it expires.
LEASE_SECONDS=30

# How often an idle worker looks for something to do.
POLL_SECONDS=0.5


# ---- 4. RETRIES -------------------------------------------
# Only steps that declare themselves retryable are retried. A step that
# failed because the input was wrong will fail the same way forever.
MAX_ATTEMPTS=3
RETRY_BASE_SECONDS=1.0
RETRY_MAX_SECONDS=30.0


# ---- 5. APPROVALS -----------------------------------------
# Equipment spend above this needs a human. The workflow parks, and may
# sit parked for days - which is exactly why the state is in a database.
APPROVAL_REQUIRED_ABOVE=2000.00
APPROVAL_EXPIRY_HOURS=72


# ---- 6. Server --------------------------------------------
HOST=127.0.0.1
PORT=8070
