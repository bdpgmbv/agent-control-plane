# ============================================================
#  COPY TO ".env" AND PASTE YOUR KEY
#      cp .env.example .env
# ============================================================

# ---- 1. The model -----------------------------------------
# "openai"  = real extraction (and vision for images)
# "offline" = template extraction with no network. Used by the tests.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-paste-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Images go through the same model. gpt-4o-mini reads them.
VISION_MODEL=gpt-4o-mini


# ---- 2. Storage -------------------------------------------
SQLITE_PATH=./data/documents.db


# ---- 3. WHEN A HUMAN MUST LOOK ----------------------------
# The numbers that decide straight-through processing. Getting these wrong is
# expensive in one direction and useless in the other.

# A document scoring at or above this is processed automatically.
AUTO_APPROVE_CONFIDENCE=0.90

# Below this it goes to a human without argument.
REVIEW_CONFIDENCE=0.60

# Any document worth more than this always gets a human, whatever it scored.
# Confidence is a judgement; a large payment is a fact.
ALWAYS_REVIEW_ABOVE_AMOUNT=10000.00

# A single required field this uncertain sends the whole document to review.
MIN_REQUIRED_FIELD_CONFIDENCE=0.70


# ---- 4. Validation tolerances -----------------------------
# Arithmetic is checked to the penny, with a small allowance for rounding.
ARITHMETIC_TOLERANCE=0.02

# How far in the past or future a document date may plausibly be.
MAX_DOCUMENT_AGE_DAYS=1825
MAX_DOCUMENT_FUTURE_DAYS=30


# ---- 5. Limits --------------------------------------------
MAX_DOCUMENT_CHARACTERS=40000
MAX_LINE_ITEMS=200


# ---- 6. Access --------------------------------------------
API_KEYS=clerk-key:clerk,reviewer-key:reviewer
REQUIRE_API_KEY=false
