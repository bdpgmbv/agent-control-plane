# ============================================================
#  COPY TO ".env" AND PASTE YOUR KEY
#      cp .env.example .env
# ============================================================

# ---- 1. The model -----------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-paste-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0


# ---- 2. BUDGETS -------------------------------------------
# The heart of this project. A research agent left unsupervised will happily
# spend fifty dollars answering one question. Every budget below is shared by
# EVERY agent in the run, not handed out per worker.

# Total tokens for the whole run, across the planner, all workers and synthesis.
BUDGET_MAX_TOKENS=120000

# Total tool calls (searches, fetches) for the whole run.
BUDGET_MAX_TOOL_CALLS=40

# Wall clock. A run that takes four minutes has already lost the user.
BUDGET_MAX_SECONDS=120

# How deep the planner may decompose. Depth 2 means a sub-question may be split
# once more, and no further. Without this, "research X" becomes a tree.
BUDGET_MAX_DEPTH=2

# How many sub-questions may be researched at once.
BUDGET_MAX_PARALLEL_WORKERS=4

# The most sub-questions a plan may contain.
BUDGET_MAX_SUBQUESTIONS=6


# ---- 3. Research tuning -----------------------------------
# Results returned per search.
SEARCH_TOP_K=5
# Evidence items kept per sub-question after ranking.
EVIDENCE_PER_SUBQUESTION=4
# Two pieces of evidence this similar are treated as the same claim.
DUPLICATE_SIMILARITY_THRESHOLD=0.82
# Evidence below this relevance is dropped rather than put in the report.
MIN_EVIDENCE_RELEVANCE=0.25


# ---- 4. Storage -------------------------------------------
SQLITE_PATH=./data/research.db


# ---- 5. Access --------------------------------------------
API_KEYS=demo-key:researcher,admin-key:admin
REQUIRE_API_KEY=false
