# ============================================================
#  COPY TO ".env" AND PASTE YOUR KEY
#      cp .env.example .env
# ============================================================

# ---- 1. Providers ------------------------------------------
# The gateway routes between them. With no key it uses the offline
# providers, which are deterministic stand-ins - so every number
# below can be measured without spending anything.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_TIMEOUT_SECONDS=40


# ---- 2. Storage --------------------------------------------
SQLITE_PATH=./data/gateway.db


# ---- 3. CACHING --------------------------------------------
# An exact cache hit costs nothing and takes a millisecond.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# A semantic hit answers a question that is merely SIMILAR to one
# already answered. Set the threshold too low and the gateway
# confidently returns the answer to a different question.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_THRESHOLD=0.88


# ---- 4. RATE LIMITS ----------------------------------------
# Per API key. A token bucket: requests_per_minute refills steadily,
# burst is how many may arrive at once.
REQUESTS_PER_MINUTE=60
BURST=10

# A hard spending cap per key, per day. The one limit that cannot be
# argued with at 3am.
DAILY_BUDGET_USD=5.00


# ---- 5. RETRIES AND FALLBACK -------------------------------
# Only a failure that might succeed next time is retried.
MAX_ATTEMPTS_PER_PROVIDER=2
RETRY_BASE_SECONDS=0.5


# ---- 6. EXPERIMENTS ----------------------------------------
# How confident you must be before the platform will name a winner.
# 0.95 means "a difference this large would happen by chance less
# than 5% of the time".
CONFIDENCE_LEVEL=0.95

# And the smallest number of samples per arm it will look at.
MINIMUM_SAMPLES_PER_ARM=30


# ---- 7. Access ---------------------------------------------
API_KEYS=demo-key:demo,team-key:team


# ---- 8. Server ---------------------------------------------
HOST=127.0.0.1
PORT=8080

# The offline hashing embedder scores lower across the board than real
# embeddings, so it needs its own threshold. Measured by
# scripts/tune_threshold.py, which reports both.
SEMANTIC_THRESHOLD_OFFLINE=0.71
