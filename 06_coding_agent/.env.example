# ============================================================
#  COPY TO ".env" AND PASTE YOUR KEY
#      cp .env.example .env
# ============================================================

# ---- 1. The model -----------------------------------------
# "openai"  = the agent really writes the patches
# "offline" = the harness runs against recorded plans, no network.
#             Used by the tests. See the README on what this does and
#             does NOT measure.
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0


# ---- 2. THE BUDGET ----------------------------------------
# An agent without a budget is an agent that runs until someone notices.

# How many edit-then-test rounds before the agent gives up and says so.
MAX_ITERATIONS=6

# Total model tokens one task may spend.
MAX_TOKENS_PER_TASK=120000

# Wall-clock seconds for the whole task.
MAX_SECONDS_PER_TASK=300

# Seconds any single test run may take before it is killed.
TEST_TIMEOUT_SECONDS=60


# ---- 3. CONTEXT COMPRESSION -------------------------------
# The agent cannot read the repository. It has to choose.
MAX_FILES_IN_CONTEXT=6
MAX_FILE_CHARACTERS=8000
MAX_TEST_OUTPUT_CHARACTERS=4000


# ---- 4. THE SANDBOX ---------------------------------------
# Where working copies are made. Each task gets its own directory.
WORKSPACE_ROOT=./workspaces

# Files the agent may never edit, whatever it asks for. See layer8.
PROTECTED_GLOBS=tests/*,test_*.py,*_test.py,conftest.py,pytest.ini,setup.cfg,tox.ini,pyproject.toml

# Largest file the agent may read or write.
MAX_EDIT_FILE_BYTES=400000


# ---- 5. Server --------------------------------------------
HOST=127.0.0.1
PORT=8060
