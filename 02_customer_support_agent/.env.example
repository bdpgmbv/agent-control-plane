# ============================================================
#  COPY TO ".env" AND PASTE YOUR KEY
#      cp .env.example .env
# ============================================================

# ---- 1. The model -----------------------------------------
# "openai"  = real calls (needs the key below)
# "offline" = rule-based agent, no network. Used by the tests.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-paste-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=700


# ---- 2. Storage -------------------------------------------
SQLITE_PATH=./data/support.db


# ---- 3. The agent loop ------------------------------------
# How many times the agent may call tools before it must answer.
# Without a cap, a confused agent loops until your bill notices.
MAX_TOOL_STEPS=5

# Retries for a tool that fails for a temporary reason.
TOOL_MAX_ATTEMPTS=3
TOOL_RETRY_BASE_SECONDS=0.2

# How many past turns to keep in full before summarising the rest.
MEMORY_RECENT_TURNS=8


# ---- 4. Money limits --------------------------------------
# A refund at or below this is issued by the agent.
# Above it, a human must approve. Never let a model move money freely.
REFUND_AUTO_APPROVE_LIMIT=50.00
REFUND_HARD_LIMIT=2000.00


# ---- 5. Escalation ----------------------------------------
# Hand to a human after this many failed tool calls in one conversation.
ESCALATE_AFTER_TOOL_FAILURES=2
# Hand to a human after this many turns without resolving anything.
ESCALATE_AFTER_TURNS=12


# ---- 6. Privacy -------------------------------------------
# Redact personal data before writing logs and audit records.
REDACT_PII_IN_LOGS=true
# Also redact before sending text to the model provider.
# Safer, but the agent then cannot read an email address the customer typed.
REDACT_PII_BEFORE_MODEL=false


# ---- 7. Who may talk to the agent -------------------------
# key:role:customer_id
# roles: customer (only their own data), agent_human (any customer, can approve)
API_KEYS=cust-alice-key:customer:CUST-1001,cust-bob-key:customer:CUST-1002,human-agent-key:agent_human:*
REQUIRE_API_KEY=true
