# ============================================================
#  COPY THIS FILE TO ".env" AND PASTE YOUR KEY BELOW
#  cp .env.example .env
# ============================================================

# ---- 1. Which LLM provider to use -------------------------
# "openai"  = real calls to OpenAI (needs OPENAI_API_KEY below)
# "offline" = no network, canned answers. Used by the tests.
LLM_PROVIDER=openai

# Paste your key here. It never leaves this machine.
OPENAI_API_KEY=sk-paste-your-key-here

# The cheap "mini" chat model used for answering questions.
LLM_MODEL=gpt-4o-mini

# A second, even cheaper model used by the evaluation judge.
JUDGE_MODEL=gpt-4o-mini


# ---- 2. Embeddings ----------------------------------------
# "openai"  = real embedding API (best quality)
# "offline" = deterministic local hashing embedder (no network, used by tests)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536


# ---- 3. Storage -------------------------------------------
# "sqlite"   = zero setup, a single file. Great for learning.
# "postgres" = production path, uses pgvector. Start it with: docker compose up -d
STORAGE_BACKEND=sqlite
SQLITE_PATH=./data/rag.db
POSTGRES_DSN=postgresql://rag:rag@localhost:5433/rag


# ---- 4. Cache ---------------------------------------------
# "memory" = in-process dict. "redis" = shared cache (docker compose up -d)
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6380/0
CACHE_TTL_SECONDS=900
SEMANTIC_CACHE_THRESHOLD=0.97


# ---- 5. Retrieval tuning ----------------------------------
CHUNK_SIZE_WORDS=180
CHUNK_OVERLAP_WORDS=40
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RERANK_TOP_K=5
MIN_RELEVANCE_SCORE=0.35
ENABLE_QUERY_REWRITE=true
ENABLE_RERANK=true


# ---- 6. Safety / RBAC ------------------------------------
# Demo API keys. Format: key:role:comma-separated-allowed-tags
# Roles: admin (can ingest + delete), user (can only ask questions)
API_KEYS=demo-admin-key:admin:public|internal|secret,demo-user-key:user:public
REQUIRE_API_KEY=true
