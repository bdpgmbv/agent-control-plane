# ============================================================
#  COPY TO ".env" AND PASTE YOUR KEY
#      cp .env.example .env
# ============================================================

# ---- 1. The model -----------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-paste-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0


# ---- 2. The analytics database ----------------------------
# "sqlite"   = zero setup, a single file, opened READ-ONLY
# "postgres" = production path, a read-only role (docker compose up -d)
DATABASE_BACKEND=sqlite
SQLITE_PATH=./data/analytics.db
POSTGRES_DSN=postgresql://readonly:readonly@localhost:5434/analytics


# ---- 3. EXECUTION LIMITS ----------------------------------
# Generated SQL is executable code written by something that cannot be trusted.
# These are the limits that hold even when the SQL looks perfectly reasonable.

# Rows returned to the caller. A LIMIT is added to any query that lacks one.
MAX_ROWS=500

# Seconds a query may run. A valid query can still be a cartesian join.
QUERY_TIMEOUT_SECONDS=5

# How many joins one query may contain. More than this is nearly always a mistake.
MAX_JOINS=6

# How many times the model may try to repair its own broken SQL.
MAX_REPAIR_ATTEMPTS=2


# ---- 4. Schema retrieval ----------------------------------
# Tables whose description is put in the prompt. With a large schema you cannot
# send all of it, and sending the wrong part is worse than sending less.
SCHEMA_TABLES_IN_PROMPT=6


# ---- 5. Access --------------------------------------------
API_KEYS=analyst-key:analyst,admin-key:admin
REQUIRE_API_KEY=false
